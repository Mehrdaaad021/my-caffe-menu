# =========================================================
# Neon PostgreSQL Database (Required for Vercel Deployment)
# Get this connection string from https://neon.tech
# =========================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# =========================================================
# Gemini AI API Key (Server-side Menu Translation & Voice Narrator)
# =========================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# =========================================================
# Security & Initial Passcodes (Set strong values in Vercel)
# =========================================================
OWNER_PASSCODE="CHANGE_ME_STRONG_OWNER_PASSCODE"
ADMIN_PASSCODE="CHANGE_ME_STRONG_ADMIN_PASSCODE"
ADMIN_SESSION_SECRET="CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS"

# Optional: Public URL of your deployed app
APP_URL="MY_APP_URL"
